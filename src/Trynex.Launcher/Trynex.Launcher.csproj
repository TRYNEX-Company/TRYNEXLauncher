<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Trynex.Core\Trynex.Core.csproj" />
    <ProjectReference Include="..\Trynex.Infrastructure\Trynex.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\Brand\trynex-mark.png" />
    <Resource Include="Assets\Brand\trynex.ico" />
    <Resource Include="Assets\Projects\mr-project.png" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\Catalog\projects.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Content\news.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Version>0.3.0-preview.11</Version>
    <AssemblyVersion>0.3.0.0</AssemblyVersion>
    <FileVersion>0.3.0.11</FileVersion>
    <ApplicationIcon>Assets\Brand\trynex.ico</ApplicationIcon>
    <AssemblyTitle>TRYNEX Launcher</AssemblyTitle>
    <Product>TRYNEX Launcher</Product>
    <Company>TRYNEX</Company>
    <Description>TRYNEX game and community launcher</Description>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

</Project>
