<Window x:Class="Trynex.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="TRYNEX"
        Icon="/Trynex.Launcher;component/Assets/Brand/trynex.ico"
        Width="1440"
        Height="860"
        MinWidth="1120"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="Transparent"
        StateChanged="Window_StateChanged">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="52"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="14"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border x:Name="RootFrame"
            Background="{StaticResource BackgroundBrush}"
            BorderBrush="#252C3E"
            BorderThickness="1"
            CornerRadius="14"
            ClipToBounds="True">
    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="52" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.RowSpan="2"
                Grid.Column="0"
                Background="#0A0C13"
                BorderBrush="#171C29"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="72" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Margin="20,0" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="38" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Width="34" Height="34" CornerRadius="9" ClipToBounds="True">
                        <Border.Background>
                            <ImageBrush ImageSource="/Trynex.Launcher;component/Assets/Brand/trynex-mark.png"
                                        Viewbox="0.27,0.10,0.46,0.58"
                                        ViewboxUnits="RelativeToBoundingBox"
                                        Stretch="Uniform" />
                        </Border.Background>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="TRYNEX" FontSize="18" FontWeight="Bold" />
                        <TextBlock Text="LAUNCHER  ·  PREVIEW" FontSize="7.5" FontWeight="SemiBold"
                                   Foreground="{StaticResource CyanBrush}" />
                    </StackPanel>
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,14,0,0">
                        <TextBlock Text="{DynamicResource Shell.Section.Main}" Margin="26,0,0,9" FontSize="9" FontWeight="SemiBold"
                                   Foreground="#596176" />

                        <ItemsControl ItemsSource="{Binding PrimaryNavigation}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource NavigationItemButtonStyle}"
                                            Command="{Binding Command}"
                                            CommandParameter="{Binding Key}"
                                            AutomationProperties.Name="{Binding Title}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="27" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="4" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding IconGlyph}" FontFamily="Segoe MDL2 Assets" FontSize="14" />
                                            <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="13" />
                                            <Border x:Name="BadgeBorder" Grid.Column="2" Background="#20304A"
                                                    CornerRadius="8" Padding="7,2" Margin="6,0,3,0">
                                                <TextBlock Text="{Binding Badge}" FontSize="8" Foreground="{StaticResource CyanBrush}" />
                                            </Border>
                                            <Border x:Name="SelectionBar" Grid.Column="3" Width="3" Height="20"
                                                    CornerRadius="2" Background="{StaticResource PurpleBrush}"
                                                    Visibility="Collapsed" />
                                        </Grid>
                                    </Button>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Badge}" Value="">
                                            <Setter TargetName="BadgeBorder" Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter TargetName="SelectionBar" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="{DynamicResource Shell.Section.Services}" Margin="26,28,0,9" FontSize="9" FontWeight="SemiBold"
                                   Foreground="#596176" />

                        <ItemsControl ItemsSource="{Binding ServiceNavigation}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource NavigationItemButtonStyle}"
                                            Command="{Binding Command}"
                                            CommandParameter="{Binding Key}"
                                            AutomationProperties.Name="{Binding Title}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="27" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="4" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding IconGlyph}" FontFamily="Segoe MDL2 Assets" FontSize="14" />
                                            <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="13" />
                                            <TextBlock Grid.Column="2" Text="{Binding Badge}" FontSize="7.5" FontWeight="Bold"
                                                       Foreground="{StaticResource GreenBrush}" />
                                            <Border x:Name="SelectionBar" Grid.Column="3" Width="3" Height="20"
                                                    CornerRadius="2" Background="{StaticResource PurpleBrush}"
                                                    Visibility="Collapsed" />
                                        </Grid>
                                    </Button>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter TargetName="SelectionBar" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="2" Margin="12,0,12,14">
                    <Button Style="{StaticResource InAppUpdateButtonStyle}"
                            Margin="0,0,0,8"
                            Command="{Binding InstallUpdateCommand}"
                            Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BooleanToVisibilityConverter}}"
                            ToolTip="{DynamicResource Shell.Update.Tooltip}"
                            AutomationProperties.Name="{DynamicResource Shell.Update.Automation}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="25" Height="25" Background="#0D4059" CornerRadius="7"
                                    HorizontalAlignment="Left" VerticalAlignment="Center">
                                <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                           Foreground="{StaticResource CyanBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding UpdateButtonTitle}"
                                           FontSize="9.5" FontWeight="Bold" Foreground="#E9FAFF"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{DynamicResource Shell.Update.Ready}" Margin="0,2,0,0"
                                           FontSize="7" FontWeight="SemiBold" Foreground="#54CEF2" />
                            </StackPanel>
                        </Grid>
                    </Button>

                    <Button Style="{StaticResource NavigationItemButtonStyle}"
                            Margin="0,0,0,8"
                            Command="{Binding SettingsNavigation.Command}"
                            CommandParameter="{Binding SettingsNavigation.Key}"
                            AutomationProperties.Name="{DynamicResource Nav.Settings}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="27" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="4" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding SettingsNavigation.IconGlyph}" FontFamily="Segoe MDL2 Assets" FontSize="14" />
                            <TextBlock Grid.Column="1" Text="{Binding SettingsNavigation.Title}" FontSize="13" />
                            <Border Grid.Column="2" Width="3" Height="20" CornerRadius="2"
                                    Background="{StaticResource PurpleBrush}"
                                    Visibility="{Binding SettingsNavigation.IsSelected, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </Grid>
                    </Button>

                    <Border Background="#10141E" BorderBrush="#1E2535" BorderThickness="1"
                            CornerRadius="12" Padding="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="38" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid Width="34" Height="34">
                                <Ellipse Fill="#211642" />
                                <TextBlock Text="{Binding IdentityInitials}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           FontSize="10" FontWeight="Bold" Foreground="#B99CFF" />
                                <Ellipse Width="9" Height="9" Fill="{StaticResource GreenBrush}"
                                         Stroke="#10141E" StrokeThickness="2"
                                         HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsIdentitySignedIn}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                            </Grid>
                            <StackPanel Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding IdentityDisplayName}" FontSize="12" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding IdentityStatus}" FontSize="8.5" Foreground="{StaticResource GreenBrush}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Button Grid.Column="2"
                                    Width="28" Height="28" Padding="0"
                                    Background="Transparent" BorderThickness="0"
                                    Foreground="#8992A7"
                                    Command="{Binding IdentityActionCommand}"
                                    ToolTip="{Binding IdentityActionTitle}"
                                    AutomationProperties.Name="{Binding IdentityActionTitle}">
                                <TextBlock Text="{Binding IdentityActionGlyph}" FontFamily="Segoe MDL2 Assets"
                                           FontSize="12" VerticalAlignment="Center" />
                            </Button>
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="0" Grid.Column="1" Background="#080A10" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Width="340" Height="34" Margin="28,0,0,0" HorizontalAlignment="Left"
                    VerticalAlignment="Center" Background="#10131C" BorderBrush="#202638"
                    BorderThickness="1" CornerRadius="9"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="38" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                               Foreground="#6F788C" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <TextBox x:Name="GlobalSearchBox" Grid.Column="1"
                             Text="{Binding GlobalSearchText, UpdateSourceTrigger=PropertyChanged}"
                             KeyDown="GlobalSearchBox_KeyDown"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="{StaticResource TextBrush}"
                             CaretBrush="{StaticResource CyanBrush}"
                             FontSize="11"
                             VerticalContentAlignment="Center"
                             ToolTip="{DynamicResource Shell.Search.Placeholder}" />
                    <TextBlock Grid.Column="1" Text="{DynamicResource Shell.Search.Placeholder}"
                               VerticalAlignment="Center" IsHitTestVisible="False"
                               FontSize="11" Foreground="#6F788C">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=GlobalSearchBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Border Grid.Column="2" Margin="0,0,8,0" Padding="6,2" Background="#191E2B" CornerRadius="5"
                            VerticalAlignment="Center">
                        <TextBlock Text="CTRL K" FontSize="7.5" Foreground="#737C91" />
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Column="1" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <ToggleButton x:Name="NotificationBell"
                              Style="{StaticResource NotificationButtonStyle}"
                              IsChecked="{Binding IsNotificationCenterOpen, Mode=TwoWay}"
                              ToolTip="{DynamicResource Notification.Center.Title}">
                    <Grid>
                        <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Border MinWidth="15" Height="15" Padding="3,0" Background="#FF4E72"
                                BorderBrush="#080A10" BorderThickness="2" CornerRadius="8"
                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-3,-4,0"
                                Visibility="{Binding HasUnreadNotifications, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="{Binding NotificationBadge}" FontSize="7" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                </ToggleButton>

                <Popup PlacementTarget="{Binding ElementName=NotificationBell}"
                       Placement="Bottom"
                       HorizontalOffset="-328"
                       VerticalOffset="6"
                       AllowsTransparency="True"
                       StaysOpen="False"
                       IsOpen="{Binding IsNotificationCenterOpen, Mode=TwoWay}">
                    <Border Width="380" MaxHeight="520" Padding="15"
                            Background="#0C1018" BorderBrush="#2A3246" BorderThickness="1"
                            CornerRadius="16">
                        <Border.Effect>
                            <DropShadowEffect Color="#000000" Opacity="0.65" BlurRadius="26" ShadowDepth="10" />
                        </Border.Effect>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel Margin="2,0,2,12">
                                <TextBlock Text="{DynamicResource Notification.Center.Title}"
                                           FontSize="16" FontWeight="SemiBold" />
                                <TextBlock Text="{DynamicResource Notification.Center.Subtitle}"
                                           Margin="0,4,0,0" FontSize="9.5" Foreground="{StaticResource MutedTextBrush}" />
                            </StackPanel>
                            <Grid Grid.Row="1">
                                <TextBlock Text="{DynamicResource Notification.Center.Empty}"
                                           Margin="8,20" HorizontalAlignment="Center"
                                           FontSize="10" Foreground="{StaticResource MutedTextBrush}"
                                           Visibility="{Binding HasNoNotifications, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <ScrollViewer MaxHeight="410" VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl ItemsSource="{Binding Notifications}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,0,0,9" Padding="12"
                                                        Background="{Binding BackgroundColor}"
                                                        BorderBrush="#293146" BorderThickness="1"
                                                        CornerRadius="12">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="34" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Width="28" Height="28" CornerRadius="9"
                                                                Background="{Binding AccentColor}" VerticalAlignment="Top">
                                                            <TextBlock Text="{Binding IconGlyph}" FontFamily="Segoe MDL2 Assets"
                                                                       FontSize="12" Foreground="#080A10"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                        <StackPanel Grid.Column="1">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding Kind}" FontSize="8" FontWeight="Bold"
                                                                           Foreground="{Binding AccentColor}" />
                                                                <TextBlock Text="  ·  " FontSize="8" Foreground="#59657B" />
                                                                <TextBlock Text="{Binding DateDisplay}" FontSize="8" Foreground="#79849A" />
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding Title}" Margin="0,5,0,0"
                                                                       FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                            <TextBlock Text="{Binding Message}" Margin="0,4,0,0"
                                                                       FontSize="9" LineHeight="14" Foreground="#A0A9BB"
                                                                       TextWrapping="Wrap" MaxHeight="45" />
                                                            <Button Margin="0,8,0,0" Padding="0" HorizontalAlignment="Left"
                                                                    Background="Transparent" BorderThickness="0"
                                                                    Foreground="{Binding AccentColor}" Cursor="Hand"
                                                                    Content="{DynamicResource Notification.ReadMore}"
                                                                    FontSize="8.5" FontWeight="SemiBold"
                                                                    Command="{Binding OpenLinkCommand}"
                                                                    Visibility="{Binding HasLink, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Grid>
                    </Border>
                </Popup>
            </Grid>

            <StackPanel Grid.Column="2" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Style="{StaticResource WindowButtonStyle}" Content="—" Click="Minimize_Click"
                        AutomationProperties.Name="{DynamicResource Shell.Window.Minimize}" />
                <Button x:Name="MaximizeButton" Style="{StaticResource WindowButtonStyle}" Content="□" Click="Maximize_Click"
                        AutomationProperties.Name="{DynamicResource Shell.Window.Maximize}" />
                <Button Style="{StaticResource CloseWindowButtonStyle}" Content="×" Click="Close_Click"
                        AutomationProperties.Name="{DynamicResource Shell.Window.Close}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Margin="28,8,20,0"
                    Padding="14,11"
                    Background="{Binding ActiveAnnouncement.BackgroundColor}"
                    BorderBrush="{Binding ActiveAnnouncement.AccentColor}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Visibility="{Binding HasActiveAnnouncement, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="25" Height="25" CornerRadius="8"
                            Background="{Binding ActiveAnnouncement.AccentColor}">
                        <TextBlock Text="{Binding ActiveAnnouncement.IconGlyph}"
                                   FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#090B10"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="9,0,12,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding ActiveAnnouncement.Kind}" FontSize="8" FontWeight="Bold"
                                       Foreground="{Binding ActiveAnnouncement.AccentColor}" />
                            <TextBlock Text="  ·  " FontSize="8" Foreground="#647087" />
                            <TextBlock Text="{Binding ActiveAnnouncement.DateDisplay}" FontSize="8" Foreground="#7F899F" />
                        </StackPanel>
                        <TextBlock Text="{Binding ActiveAnnouncement.Title}" Margin="0,3,0,0"
                                   FontSize="11.5" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding ActiveAnnouncement.Message}" Margin="0,2,0,0"
                                   FontSize="9.5" Foreground="#A7B0C2" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Margin="0,0,8,0" Padding="10,6" Style="{StaticResource SecondaryButtonStyle}"
                                Content="{DynamicResource Notification.ReadMore}"
                                Command="{Binding ActiveAnnouncement.OpenLinkCommand}"
                                Visibility="{Binding ActiveAnnouncement.HasLink, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <Button Width="30" Height="30" Padding="0" Style="{StaticResource SecondaryButtonStyle}"
                                Content="×" FontSize="15"
                                ToolTip="{DynamicResource Notification.Dismiss}"
                                Command="{Binding DismissAnnouncementCommand}"
                                CommandParameter="{Binding ActiveAnnouncement.Id}"
                                Visibility="{Binding ActiveAnnouncement.CanDismiss, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </StackPanel>
                </Grid>
            </Border>

            <ContentControl Grid.Row="1" Content="{Binding CurrentPage}" />
        </Grid>
    </Grid>
    </Border>
</Window>
