<UserControl x:Class="Trynex.Launcher.Views.MessengerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundBrush}">
    <Grid Margin="30,20,30,34">
        <Border CornerRadius="18" BorderBrush="#244032" BorderThickness="1" ClipToBounds="True">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#101E1A" Offset="0" />
                    <GradientStop Color="#101326" Offset="0.58" />
                    <GradientStop Color="#17102B" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Ellipse Width="520" Height="520" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                         Margin="-230,0,0,-300" Fill="#17375A2D" />
                <Ellipse Width="420" Height="420" HorizontalAlignment="Right" VerticalAlignment="Top"
                         Margin="0,-210,-150,0" Fill="#172B1A58" />

                <StackPanel Width="620" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid Width="82" Height="82" HorizontalAlignment="Center">
                        <Border Background="#132A22" BorderBrush="#245A3C" BorderThickness="1" CornerRadius="22" />
                        <TextBlock Text="&#xE8BD;" FontFamily="Segoe MDL2 Assets" FontSize="34"
                                   Foreground="{StaticResource GreenBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock Text="TRYNEX Messenger" Margin="0,24,0,0" FontSize="31" FontWeight="Bold"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="{DynamicResource Messenger.Subtitle}"
                               Margin="0,9,0,0" FontSize="14" Foreground="#B0B9CA" HorizontalAlignment="Center" />
                    <TextBlock Text="{DynamicResource Messenger.Description}"
                               Margin="0,22,0,0" FontSize="11" LineHeight="18" TextAlignment="Center"
                               Foreground="{StaticResource MutedTextBrush}" />

                    <Grid Margin="0,30,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Margin="0,0,7,0" Padding="16" Background="#A80D1515"
                                BorderBrush="#263A33" BorderThickness="1" CornerRadius="12">
                            <StackPanel>
                                <TextBlock Text="01" FontSize="9" FontWeight="Bold" Foreground="{StaticResource GreenBrush}" />
                                <TextBlock Text="{DynamicResource Messenger.Simple}" Margin="0,7,0,0" FontSize="11" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Margin="4,0" Padding="16" Background="#A80D1515"
                                BorderBrush="#263A33" BorderThickness="1" CornerRadius="12">
                            <StackPanel>
                                <TextBlock Text="02" FontSize="9" FontWeight="Bold" Foreground="{StaticResource CyanBrush}" />
                                <TextBlock Text="{DynamicResource Messenger.Sync}" Margin="0,7,0,0" FontSize="11" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Margin="7,0,0,0" Padding="16" Background="#A80D1515"
                                BorderBrush="#263A33" BorderThickness="1" CornerRadius="12">
                            <StackPanel>
                                <TextBlock Text="03" FontSize="9" FontWeight="Bold" Foreground="#B99CFF" />
                                <TextBlock Text="{DynamicResource Messenger.E2ee}" Margin="0,7,0,0" FontSize="11" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Width="138" Margin="0,28,0,0" HorizontalAlignment="Center" Background="#10251A"
                            BorderBrush="#1D5730" BorderThickness="1" CornerRadius="11" Padding="12,7">
                        <TextBlock Text="{DynamicResource Messenger.Research}" FontSize="8" FontWeight="Bold" Foreground="{StaticResource GreenBrush}"
                                   HorizontalAlignment="Center" />
                    </Border>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
