<UserControl x:Class="Trynex.Launcher.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="30,20,30,34">
            <Grid Margin="2,0,2,18">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Home.Welcome}" FontSize="25" FontWeight="SemiBold" />
                    <TextBlock Text="{DynamicResource Home.Subtitle}"
                               Margin="0,5,0,0" FontSize="12" Foreground="{StaticResource MutedTextBrush}" />
                </StackPanel>
                <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="#10251A"
                        BorderBrush="#1C5730" BorderThickness="1" CornerRadius="13" Padding="11,5">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="6" Height="6" Fill="{StaticResource GreenBrush}" Margin="0,0,7,0" />
                        <TextBlock Text="{DynamicResource Home.SystemOk}" FontSize="8.5" FontWeight="Bold" Foreground="#75F091" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Height="278" CornerRadius="18" ClipToBounds="True" BorderBrush="#2B2250" BorderThickness="1">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#191036" Offset="0" />
                        <GradientStop Color="#101729" Offset="0.58" />
                        <GradientStop Color="#07151B" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.15*" />
                        <ColumnDefinition Width="0.85*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Margin="38,0,10,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <Border Background="#2C195B" CornerRadius="10" Padding="9,4">
                                <TextBlock Text="TRYNEX ECOSYSTEM" FontSize="8" FontWeight="Bold" Foreground="#C0A8FF" />
                            </Border>
                            <TextBlock Text="{DynamicResource Home.UpdatesConnected}" Margin="10,0,0,0" VerticalAlignment="Center"
                                       FontSize="8" Foreground="{StaticResource GreenBrush}" />
                        </StackPanel>
                        <TextBlock Text="{DynamicResource Home.Hero.Title}" FontSize="34" FontWeight="Black" LineHeight="37" />
                        <TextBlock Text="{DynamicResource Home.Hero.Description}"
                                   Margin="0,12,0,20" FontSize="12" LineHeight="19" Foreground="#AAB2C4" />
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource PrimaryButtonStyle}"
                                    Content="{DynamicResource Home.OpenLibrary}"
                                    Command="{Binding OpenLibraryCommand}" />
                            <Button Style="{StaticResource SecondaryButtonStyle}"
                                    Content="{DynamicResource Home.OpenDownloads}"
                                    Command="{Binding OpenDownloadsCommand}"
                                    Margin="10,0,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <Grid Grid.Column="1" ClipToBounds="True">
                        <Ellipse Width="430" Height="430" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Ellipse.Fill>
                                <RadialGradientBrush>
                                    <GradientStop Color="#4A2CD1FF" Offset="0" />
                                    <GradientStop Color="#0012B9EB" Offset="1" />
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>
                        <Border Width="252" Height="252" HorizontalAlignment="Center" VerticalAlignment="Center"
                                CornerRadius="126">
                            <Border.Background>
                                <ImageBrush ImageSource="/Trynex.Launcher;component/Assets/Brand/trynex-mark.png"
                                            Viewbox="0.27,0.10,0.46,0.58"
                                            ViewboxUnits="RelativeToBoundingBox"
                                            Stretch="Uniform" />
                            </Border.Background>
                        </Border>
                        <Border Width="142" Height="32" Margin="0,0,22,22" HorizontalAlignment="Right"
                                VerticalAlignment="Bottom" Background="#CC0D111A" BorderBrush="#2A354A"
                                BorderThickness="1" CornerRadius="9">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Ellipse Width="6" Height="6" Fill="{StaticResource GreenBrush}" />
                                <TextBlock Text="  READY TO PLAY" FontSize="8" FontWeight="Bold" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <Grid Margin="2,24,2,12">
                <TextBlock Text="{DynamicResource Home.Continue}" FontSize="17" FontWeight="SemiBold" />
                <Button HorizontalAlignment="Right" Background="Transparent" BorderThickness="0"
                        Foreground="{StaticResource MutedTextBrush}" Content="{DynamicResource Home.ViewAll}"
                        Command="{Binding OpenLibraryCommand}"
                        FontSize="9" FontWeight="SemiBold" Cursor="Hand" />
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.05*" />
                    <ColumnDefinition Width="0.95*" />
                    <ColumnDefinition Width="0.95*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Height="174" Margin="0,0,10,0" Background="#11151F"
                        BorderBrush="#293143" BorderThickness="1" CornerRadius="14" ClipToBounds="True">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Background="#16102B">
                            <Rectangle Opacity="0.7">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#402076" Offset="0" />
                                        <GradientStop Color="#12293D" Offset="1" />
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                            <Border Width="132" Height="132" Background="#2D2D2D" CornerRadius="12"
                                    BorderBrush="#3A4254" BorderThickness="1" ClipToBounds="True"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Image Source="/Trynex.Launcher;component/Assets/Projects/mr-project.png"
                                       Stretch="Uniform">
                                    <Image.Clip>
                                        <RectangleGeometry Rect="0,0,132,132" RadiusX="16" RadiusY="16" />
                                    </Image.Clip>
                                </Image>
                            </Border>
                        </Grid>
                        <StackPanel Grid.Column="1" Margin="18,0" VerticalAlignment="Center">
                            <TextBlock Text="MR PROJECT" FontSize="14" FontWeight="Bold" />
                            <TextBlock Text="ARMA REFORGER" Margin="0,4,0,0" FontSize="9" Foreground="{StaticResource MutedTextBrush}" />
                            <StackPanel Orientation="Horizontal" Margin="0,13,0,0">
                                <Ellipse Width="6" Height="6" Fill="{StaticResource CyanBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="{DynamicResource Home.Mr.Status}" FontSize="8" FontWeight="SemiBold" Foreground="#68D9FA" />
                            </StackPanel>
                            <Border Height="3" Margin="0,15,0,0" Background="#252B39" CornerRadius="2">
                                <Border Width="78" HorizontalAlignment="Left" Background="{StaticResource PurpleBrush}" CornerRadius="2" />
                            </Border>
                        </StackPanel>
                        <Button Grid.ColumnSpan="2" Background="#01000000" BorderThickness="0"
                                Cursor="Hand" Focusable="False" Command="{Binding OpenMrProjectCommand}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" />
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>

                <Border Grid.Column="1" Height="174" Margin="5,0,5,0" Style="{StaticResource PageCardStyle}">
                    <Grid Margin="20">
                        <StackPanel VerticalAlignment="Center">
                            <Border Width="38" Height="38" HorizontalAlignment="Left" Background="#102A21" CornerRadius="10">
                                <TextBlock Text="&#xE8BD;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                           Foreground="{StaticResource GreenBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="TRYNEX Messenger" Margin="0,13,0,0" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock Text="{DynamicResource Home.Messenger.Description}"
                                       Margin="0,5,0,0" FontSize="10" Foreground="{StaticResource MutedTextBrush}" />
                            <TextBlock Text="{DynamicResource Common.InDevelopment}" Margin="0,13,0,0" FontSize="8" FontWeight="Bold"
                                       Foreground="{StaticResource GreenBrush}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Height="174" Margin="10,0,0,0" Style="{StaticResource PageCardStyle}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Border Width="42" Height="42" Background="#171D29" CornerRadius="12">
                            <TextBlock Text="+" FontSize="24" FontWeight="Light" Foreground="#7F899E"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="{DynamicResource Home.AddProject}" Margin="0,12,0,0" FontSize="12" FontWeight="SemiBold" />
                        <TextBlock Text="{DynamicResource Home.AddProject.Description}" Margin="0,5,0,0" FontSize="9"
                                   Foreground="{StaticResource MutedTextBrush}" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Margin="2,22,2,12">
                <TextBlock Text="{DynamicResource News.Home.Title}" FontSize="17" FontWeight="SemiBold" />
                <Button HorizontalAlignment="Right" Background="Transparent" BorderThickness="0"
                        Foreground="{StaticResource MutedTextBrush}"
                        Content="{DynamicResource News.ViewAll}"
                        Command="{Binding OpenCommunityCommand}"
                        FontSize="9" FontWeight="SemiBold" Cursor="Hand" />
            </Grid>

            <ItemsControl ItemsSource="{Binding News}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="3" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Height="178" Margin="5,0" Padding="17" Style="{StaticResource PageCardStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="34" Height="34" Background="#171C29" CornerRadius="9"
                                                BorderBrush="#2B3347" BorderThickness="1" ClipToBounds="True">
                                            <Image Source="{Binding ArtworkPath}" Stretch="Uniform">
                                                <Image.Clip>
                                                    <RectangleGeometry Rect="0,0,34,34" RadiusX="9" RadiusY="9" />
                                                </Image.Clip>
                                            </Image>
                                        </Border>
                                        <StackPanel Margin="9,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Category}" FontSize="8" FontWeight="Bold"
                                                       Foreground="{StaticResource CyanBrush}" />
                                            <TextBlock Text="{Binding DateDisplay}" Margin="0,2,0,0" FontSize="7.5"
                                                       Foreground="#6F788D" />
                                        </StackPanel>
                                    </StackPanel>
                                    <Ellipse Width="6" Height="6" HorizontalAlignment="Right" VerticalAlignment="Top"
                                             Fill="{StaticResource GreenBrush}" />
                                </Grid>
                                <StackPanel Grid.Row="1" Margin="0,11,0,0">
                                    <TextBlock Text="{Binding Title}" FontSize="11.5" FontWeight="SemiBold"
                                               TextWrapping="Wrap" MaxHeight="34" />
                                    <TextBlock Text="{Binding Summary}" Margin="0,5,0,0" FontSize="9"
                                               LineHeight="13" TextWrapping="Wrap" MaxHeight="40"
                                               Foreground="{StaticResource MutedTextBrush}" />
                                </StackPanel>
                                <Button Grid.Row="2" HorizontalAlignment="Left" Padding="0" Background="Transparent"
                                        BorderThickness="0" Foreground="#77DDF8" FontSize="8.5" Cursor="Hand"
                                        Content="{DynamicResource News.ReadMore}"
                                        Command="{Binding OpenLinkCommand}"
                                        Visibility="{Binding HasLink, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid Margin="0,22,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.4*" />
                    <ColumnDefinition Width="0.6*" />
                </Grid.ColumnDefinitions>
                <Border Margin="0,0,10,0" Padding="20,17" Style="{StaticResource PageCardStyle}">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Home.Updates.Title}" FontSize="12" FontWeight="SemiBold" />
                            <TextBlock Text="{DynamicResource Home.Updates.Description}"
                                       Margin="0,5,0,0" FontSize="10" Foreground="{StaticResource MutedTextBrush}" />
                        </StackPanel>
                        <Border HorizontalAlignment="Right" Background="#10251A" CornerRadius="10" Padding="10,5" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource Common.Verified}" FontSize="8" FontWeight="Bold" Foreground="{StaticResource GreenBrush}" />
                        </Border>
                    </Grid>
                </Border>
                <Border Grid.Column="1" Margin="5,0,0,0" Padding="20,17" Style="{StaticResource PageCardStyle}">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Home.Version}" FontSize="10" Foreground="{StaticResource MutedTextBrush}" />
                            <TextBlock Text="{Binding VersionDisplay}" Margin="0,5,0,0" FontSize="13" FontWeight="SemiBold" />
                        </StackPanel>
                        <TextBlock Text=".NET 10" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   FontSize="9" FontWeight="Bold" Foreground="{StaticResource CyanBrush}" />
                    </Grid>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
