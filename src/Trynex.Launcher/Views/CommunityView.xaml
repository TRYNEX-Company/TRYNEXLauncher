<UserControl x:Class="Trynex.Launcher.Views.CommunityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="30,20,30,34">
            <StackPanel Margin="2,0,2,22">
                <TextBlock Text="{DynamicResource Community.Title}" FontSize="25" FontWeight="SemiBold" />
                <TextBlock Text="{DynamicResource Community.Subtitle}"
                           Margin="0,5,0,0" FontSize="12" Foreground="{StaticResource MutedTextBrush}" />
            </StackPanel>

            <Border Height="300" CornerRadius="16" BorderBrush="#27304A" BorderThickness="1" ClipToBounds="True">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#18112E" Offset="0" />
                        <GradientStop Color="#0D1723" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Ellipse Width="360" Height="360" Margin="0,-180,-150,0" HorizontalAlignment="Right" VerticalAlignment="Top"
                             Fill="#242D20A0" />
                    <StackPanel Margin="38" VerticalAlignment="Center">
                        <Border Width="48" Height="48" HorizontalAlignment="Left" Background="#211945" CornerRadius="13">
                            <TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets" FontSize="21"
                                       Foreground="#B79BFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="{DynamicResource Community.Hero.Title}" Margin="0,18,0,0"
                                   FontSize="25" FontWeight="Bold" />
                        <TextBlock Text="{DynamicResource Community.Hero.Description}"
                                   Margin="0,10,0,0" FontSize="11" Foreground="#A7B0C3"
                                   TextWrapping="Wrap" MaxWidth="650" HorizontalAlignment="Left" />
                        <Border Width="112" Margin="0,20,0,0" HorizontalAlignment="Left" Background="#10251A"
                                BorderBrush="#1D5730" BorderThickness="1" CornerRadius="10" Padding="10,6">
                            <TextBlock Text="{DynamicResource News.Live}" FontSize="8" FontWeight="Bold" Foreground="{StaticResource GreenBrush}"
                                       HorizontalAlignment="Center" />
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Margin="2,20,2,12">
                <TextBlock Text="{DynamicResource News.All.Title}" FontSize="17" FontWeight="SemiBold" />
                <TextBlock Text="{DynamicResource News.OfflineReady}" HorizontalAlignment="Right"
                           VerticalAlignment="Center" FontSize="9" Foreground="{StaticResource MutedTextBrush}" />
            </Grid>

            <ItemsControl ItemsSource="{Binding News}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,11" Padding="20" Style="{StaticResource PageCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="98" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="82" Height="82" HorizontalAlignment="Left"
                                        Background="#181C28" BorderBrush="#2B3347" BorderThickness="1"
                                        CornerRadius="14" ClipToBounds="True">
                                    <Image Source="{Binding ArtworkPath}" Stretch="Uniform" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Category}" FontSize="8" FontWeight="Bold"
                                                   Foreground="{StaticResource CyanBrush}" />
                                        <TextBlock Text="  ·  " FontSize="8" Foreground="#596176" />
                                        <TextBlock Text="{Binding DateDisplay}" FontSize="8" Foreground="#768096" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding Title}" Margin="0,6,0,0" FontSize="14" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Summary}" Margin="0,6,0,0" MaxWidth="760"
                                               HorizontalAlignment="Left" FontSize="10" LineHeight="15"
                                               TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" />
                                </StackPanel>
                                <Button Grid.Column="2" Margin="18,0,0,0" VerticalAlignment="Center"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Content="{DynamicResource News.ReadMore}"
                                        Command="{Binding OpenLinkCommand}"
                                        Visibility="{Binding HasLink, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
