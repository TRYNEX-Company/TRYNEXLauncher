<UserControl x:Class="Trynex.Launcher.Views.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="30,20,30,34">
            <Grid Margin="2,0,2,22">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Library.Title}" FontSize="25" FontWeight="SemiBold" />
                    <TextBlock Text="{DynamicResource Library.Subtitle}"
                               Margin="0,5,0,0" FontSize="12" Foreground="{StaticResource MutedTextBrush}" />
                </StackPanel>
                <Border Width="290" Height="38" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Background="#10141D" BorderBrush="#242C3E" BorderThickness="1" CornerRadius="9">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="38" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                   Foreground="#6F788C" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}"
                                 CaretBrush="{StaticResource CyanBrush}" VerticalContentAlignment="Center"
                                 FontSize="11" ToolTip="{DynamicResource Library.Search}" />
                    </Grid>
                </Border>
            </Grid>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                <Border Background="#211744" BorderBrush="#4B2C91" BorderThickness="1" CornerRadius="9" Padding="13,7">
                    <TextBlock Text="{DynamicResource Library.Filter.All}" FontSize="9" FontWeight="Bold" Foreground="#CBB9FF" />
                </Border>
                <Border Margin="8,0,0,0" Background="#10141D" BorderBrush="#242C3E" BorderThickness="1" CornerRadius="9" Padding="13,7">
                    <TextBlock Text="{DynamicResource Library.Filter.Installed}" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" />
                </Border>
                <Border Margin="8,0,0,0" Background="#10141D" BorderBrush="#242C3E" BorderThickness="1" CornerRadius="9" Padding="13,7">
                    <TextBlock Text="{DynamicResource Library.Filter.Favorites}" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" />
                </Border>
            </StackPanel>

            <ItemsControl ItemsSource="{Binding FilteredGames}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Height="260" Margin="0,0,0,14" Style="{StaticResource PageCardStyle}" ClipToBounds="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="360" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid>
                                    <Rectangle>
                                        <Rectangle.Fill>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#3A1C72" Offset="0" />
                                                <GradientStop Color="#17243A" Offset="0.68" />
                                                <GradientStop Color="#0B1720" Offset="1" />
                                            </LinearGradientBrush>
                                        </Rectangle.Fill>
                                    </Rectangle>
                                    <Ellipse Width="240" Height="240" Fill="#205A36B7" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-70,-50,0" />
                                    <Border Width="222" Height="222" Background="#2D2D2D" CornerRadius="18"
                                            BorderBrush="#41495C" BorderThickness="1" ClipToBounds="True"
                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Image Source="{Binding ArtworkPath}"
                                               Stretch="Uniform">
                                            <Image.Clip>
                                                <RectangleGeometry Rect="0,0,222,222" RadiusX="24" RadiusY="24" />
                                            </Image.Clip>
                                        </Image>
                                    </Border>
                                </Grid>

                                <Grid Grid.Column="1" Margin="28,24">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontSize="21" FontWeight="Bold" />
                                            <TextBlock Text="{Binding Platform}" Margin="0,5,0,0" FontSize="10"
                                                       Foreground="{StaticResource MutedTextBrush}" />
                                        </StackPanel>
                                        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="#102331"
                                                BorderBrush="#24506B" BorderThickness="1" CornerRadius="10" Padding="10,5">
                                            <TextBlock Text="{Binding Status}" FontSize="8" FontWeight="Bold"
                                                       Foreground="{Binding StatusColor}" />
                                        </Border>
                                    </Grid>

                                    <TextBlock Grid.Row="1" Text="{Binding Description}" Margin="0,18,0,0"
                                               FontSize="11" Foreground="#A8B0C2" TextWrapping="Wrap" />

                                    <Grid Grid.Row="2">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Background="#141A25" CornerRadius="8" Padding="10,6">
                                                <TextBlock Text="{DynamicResource Library.LastLaunch}" FontSize="9" Foreground="#7D879A" />
                                            </Border>
                                            <Border Margin="8,0,0,0" Background="#141A25" CornerRadius="8" Padding="10,6">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{DynamicResource Library.Version}" FontSize="9" Foreground="#7D879A" />
                                                    <TextBlock Text="{Binding Version}" Margin="5,0,0,0" FontSize="9" Foreground="#AAB4C9" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                        <Button HorizontalAlignment="Right" Style="{StaticResource PrimaryButtonStyle}"
                                                Content="{DynamicResource Library.OpenProject}"
                                                Command="{Binding DataContext.OpenProjectCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Height="120" Style="{StaticResource PageCardStyle}" BorderBrush="#262D3E">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="+" FontSize="24" Foreground="#6E788D" HorizontalAlignment="Center" />
                    <TextBlock Text="{DynamicResource Library.Footer}"
                               Margin="0,7,0,0" FontSize="10" Foreground="{StaticResource MutedTextBrush}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
