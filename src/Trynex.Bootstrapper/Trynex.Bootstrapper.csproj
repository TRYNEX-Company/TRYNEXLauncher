<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Trynex.Core\Trynex.Core.csproj" />
    <ProjectReference Include="..\Trynex.Infrastructure\Trynex.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\trynex-mark.png" />
    <Resource Include="Assets\trynex.ico" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Version>0.2.0-preview.2</Version>
    <AssemblyVersion>0.2.0.0</AssemblyVersion>
    <FileVersion>0.2.0.2</FileVersion>
    <AssemblyName>TRYNEX</AssemblyName>
    <RootNamespace>Trynex.Bootstrapper</RootNamespace>
    <ApplicationIcon>Assets\trynex.ico</ApplicationIcon>
    <AssemblyTitle>TRYNEX</AssemblyTitle>
    <Product>TRYNEX Launcher</Product>
    <Company>TRYNEX</Company>
    <Description>TRYNEX secure launcher and update bootstrapper</Description>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

</Project>
